# Copie para .streamlit/secrets.toml e preencha.
# Este arquivo é usado no deploy (Streamlit Community Cloud); em execução
# local, o .env com DATABASE_URL tem precedência.
#
# NUNCA comite o secrets.toml preenchido — só este .example.

# Conexão com o banco. No Neon, use a connection string com sslmode=require.
db_url = "postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/cnpj?sslmode=require"

# Competência da extração — define onde as séries temporais terminam.
CNPJ_COMPETENCIA = "2026-02-28"

# ---------------------------------------------------------------------------
# Modo demonstração
#
# true  → o app entra sem login e exibe banner fixo avisando que os dados são
#         sintéticos. É o que a instância pública usa.
# false → tela de login normal.
#
# Ligue SOMENTE quando o banco apontado for a base de demonstração. Sobre
# dados reais, isso deixa o dashboard aberto sem autenticação nenhuma.
# ---------------------------------------------------------------------------
modo_demo = true
