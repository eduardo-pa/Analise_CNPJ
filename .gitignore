# =============================================================
#  Segredos — NUNCA commitar
# =============================================================
.env
.env.local
.streamlit/secrets.toml
!.env.example                 # o template, sem valores, DEVE ser versionado

# =============================================================
#  Dados brutos da Receita Federal (pesados demais para o Git)
# =============================================================
2026-02.zip
2026-*/                       # pasta descompactada dos ZIPs mensais
*.zip
*.csv
*.tsv
*.parquet
dumps/                        # dumps do Postgres
*.dump
*.backup

# ATENÇÃO: não ignore *.sql de forma ampla.
# DDL, migrations e views materializadas são CÓDIGO e devem ser versionados
# (init_indexes.sql, mv_comparador_uf_kpis.sql).
dumps/*.sql

